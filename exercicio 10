ProcessamentoDadosException.java
public class ProcessamentoDadosException extends Exception {

    public ProcessamentoDadosException(String mensagem, Throwable causa) {
        super(mensagem, causa);
    }
}
Servico.java
import java.io.IOException;

public class Servico {

    public void processarArquivo(String caminho) throws ProcessamentoDadosException {

        try {

            if (caminho == null || caminho.isEmpty()) {
                throw new IOException("Caminho do arquivo inválido.");
            }

            if (caminho.equals("erro")) {
                throw new Exception("Erro durante o processamento dos dados.");
            }

            System.out.println("Arquivo processado com sucesso.");

        } catch (Exception e) {
            throw new ProcessamentoDadosException(
                "Não foi possível processar o arquivo.",
                e
            );
        }
    }
}
Main.java
public class Main {

    public static void main(String[] args) {

        Servico servico = new Servico();

        try {
            servico.processarArquivo("");

        } catch (ProcessamentoDadosException e) {

            System.out.println("Erro: " + e.getMessage());
            System.out.println("Causa: " + e.getCause().getMessage());
        }
    }
}
